[Unit]
Description=Florrclone protocol 3 online game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=florrclone
Group=florrclone
WorkingDirectory=/opt/florrclone/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8788
Environment=WEB_ROOT=/opt/florrclone/current/web
Environment=DB_PATH=/var/lib/florrclone/inventory.json
ExecStart=/opt/florrclone/runtime/bin/node /opt/florrclone/current/start.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=25
KillSignal=SIGTERM
StateDirectory=florrclone
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/florrclone
LimitNOFILE=65535
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
